{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Unzip, fetch and generate fonts, generate README.md",
            "type": "shell",
            "command": "bash",
            "args": ["-c", "./src/main.sh ${input:runopts}"],
            "problemMatcher": []
        },
        {
            "label": "Generate README.md",
            "type": "shell",
            "command": "bash",
            "args": ["-c", "./src/generate-readme.sh ${input:readmeopts}"],
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "runopts",
            "type": "command",
            "command": "extension.commandvariable.pickStringRemember",
            "args": {
                "description": "",
                "key": "runopts",
                "multiPick": true,
                "separator": " ",
                "options": [
                    {
                        "label": "Only proceed if icons unzipped",
                        "value": "--mustunzip"
                    },
                    {
                        "label": "Only proceed if upstream font updated or icons unzipped",
                        "value": "--mustupdate"
                    },
                    {
                        "label": "Do not fetch fonts",
                        "value": "--nofetch"
                    },
                    {
                        "label": "Skip generating README SVGs",
                        "value": "--nosvgs"
                    }
                ],
                "default": "--cancel"
            }
        },
        {
            "id": "readmeopts",
            "type": "command",
            "command": "extension.commandvariable.pickStringRemember",
            "args": {
                "description": "",
                "key": "readmeopts",
                "multiPick": true,
                "separator": " ",
                "options": [{ "label": "Skip generating SVGs", "value": "--nosvgs" }],
                "default": "--cancel"
            }
        }
    ]
}
